# Copy this to create ".env". .env is ignored by Git; this file is tracked.
#   PowerShell:  Copy-Item .env.example .env
#   Git Bash:    cp .env.example .env

APP_NAME=SeatPulse API
DEBUG=True

# Comma-separated. Use the actual domain in production.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# NOTE: When running in Docker, DATABASE_URL is provided by docker-compose
# (via environment: block), and environment variables take precedence over
# this file. This line is only used when running the backend outside Docker.
# "db" = compose service name. Use localhost when running outside Docker.
DATABASE_URL=postgresql+psycopg2://seatpulse:seatpulse_dev_password@db:5432/seatpulse

# Print SQL queries to logs? Useful for debugging.
DB_ECHO=False

# ---------- Auth ----------
# ⚠️ MUST change in production. Generate a new one:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-secret-CHANGE-IN-PRODUCTION
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7
# Set to True in production (HTTPS)
COOKIE_SECURE=False

# ---------- Google OAuth ----------
# Leave empty to disable Google login (button will be hidden),
# email/password login will still work.
#
# Setup instructions:
#   1. console.cloud.google.com -> New Project
#   2. APIs & Services -> OAuth consent screen -> External
#      scopes: userinfo.email, userinfo.profile
#      Add your own Gmail under Test users
#   3. Credentials -> Create Credentials -> OAuth client ID -> Web application
#   4. Set the Authorized redirect URI to EXACTLY this:
#      http://localhost:8000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# User will be redirected here after Google login
FRONTEND_URL=http://localhost:5173

# ---------- Payments ----------
# Leave empty to use MOCK provider — the entire checkout flow can be
# tested without a Stripe account (a simulated checkout page opens
# on the frontend). Same pattern used for Google OAuth.
#
# For real Stripe test mode:
#   1. Sign up at dashboard.stripe.com (test mode is available immediately)
#   2. Developers -> API keys -> Secret key (sk_test_...)
#   3. Developers -> Webhooks -> Add endpoint
#        URL:    http://localhost:8000/api/payments/webhook
#        Events: checkout.session.completed, checkout.session.expired
#      (for localhost, use the `stripe listen --forward-to ...` CLI)
#   4. Put the signing secret (whsec_...) below
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Time allowed to complete checkout. Seat lock is extended for this
# duration — otherwise the lock might expire mid-payment, causing
# the seat to be taken by someone else after payment.
PAYMENT_TTL_SECONDS=600
CURRENCY=INR

# ---- Benchmark mode (Phase 15) ----
# When enabled, the booking endpoint accepts `?strategy=` and `?redis_lock=`
# to measure optimistic vs pessimistic locking.
# Always false in production — these knobs alter locking semantics.
BENCHMARK_MODE=false

# ---- Natural language seat search (Phase 19) ----
# Gemini API key: https://aistudio.google.com/apikey (free)
#
# Leave empty to hide the search box — normal price/section
# filters will still work. AI is an optional addition, not a dependency.
GEMINI_API_KEY=
