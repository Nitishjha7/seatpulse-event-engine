# Isko copy karke ".env" banao. .env Git me nahi jayega, ye file jayegi.
#   PowerShell:  Copy-Item .env.example .env
#   Git Bash:    cp .env.example .env

APP_NAME=SeatPulse API
DEBUG=True

# Comma se alag. Production me yahan asli domain daalna.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# NOTE: Docker me chalate waqt DATABASE_URL docker-compose se aata hai
# (environment: block se), aur environment variable ki priority is file se
# ZYADA hoti hai. Ye line sirf tab kaam aati hai jab backend Docker ke bahar chalao.
# "db" = compose service ka naam. Docker ke bahar chalao to localhost karna.
DATABASE_URL=postgresql+psycopg2://seatpulse:seatpulse_dev_password@db:5432/seatpulse

# SQL queries logs me print karni hain? Debugging me kaam aata hai.
DB_ECHO=False

# ---------- Auth ----------
# ⚠️ Production me ZAROOR badalna. Naya banao:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-secret-CHANGE-IN-PRODUCTION
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7
# Production (HTTPS) me True karna
COOKIE_SECURE=False

# ---------- Google OAuth ----------
# Khali chhodo to Google login band rehta hai (button hi nahi dikhega),
# email/password phir bhi chalega.
#
# Banane ka tarika:
#   1. console.cloud.google.com -> New Project
#   2. APIs & Services -> OAuth consent screen -> External
#      scopes: userinfo.email, userinfo.profile
#      Test users me apna Gmail add karo
#   3. Credentials -> Create Credentials -> OAuth client ID -> Web application
#   4. Authorized redirect URI me BILKUL ye daalo:
#      http://localhost:8000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# Google login ke baad user yahan wapas aayega
FRONTEND_URL=http://localhost:5173

# ---------- Payments ----------
# Khali chhodo to MOCK provider chalta hai — poora checkout flow bina
# Stripe account ke test ho jata hai (frontend pe ek simulated checkout
# page khulta hai). Yahi pattern Google OAuth me use kiya hai.
#
# Asli Stripe test mode chahiye to:
#   1. dashboard.stripe.com pe signup (test mode turant milta hai)
#   2. Developers -> API keys -> Secret key (sk_test_...)
#   3. Developers -> Webhooks -> Add endpoint
#        URL:    http://localhost:8000/api/payments/webhook
#        Events: checkout.session.completed, checkout.session.expired
#      (localhost ke liye `stripe listen --forward-to ...` CLI use karo)
#   4. Signing secret (whsec_...) neeche daalo
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Checkout complete karne ke liye kitna time. Seat lock bhi itni der
# extend ho jata hai — warna payment ke beech me lock chhut jaye aur
# paisa katne ke baad seat kisi aur ki ho.
PAYMENT_TTL_SECONDS=600
CURRENCY=INR

# ---- Benchmark mode (Phase 15) ----
# On karne par booking endpoint `?strategy=` aur `?redis_lock=` maanta hai,
# taki optimistic vs pessimistic locking maapi ja sake.
# Production me hamesha false — ye knobs locking semantics badalte hain.
BENCHMARK_MODE=false

# ---- Natural language seat search (Phase 19) ----
# Gemini API key: https://aistudio.google.com/apikey (free)
#
# Khali chhod do to search box dikhta hi nahi — normal price/section
# filters phir bhi chalte hain. AI ek addition hai, dependency nahi.
GEMINI_API_KEY=
