# Ye files container me copy NAHI hongi (COPY . . ke waqt).
# Fayda: build fast, image chhoti, aur secrets container me nahi jaate.

__pycache__/
*.py[cod]
*.egg-info/
venv/
env/
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
