# These files will NOT be copied into the container (during COPY . .).
# Benefit: faster builds, smaller images, and secrets are not exposed.

__pycache__/
*.py[cod]
*.egg-info/
venv/
env/
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Secrets — these should never be included in the image
.env
.env.*
*.pem
*.key

# Git and documentation are not needed in the container
.git
.gitignore
Dockerfile
.dockerignore
README.md
*.md

# Local database files
*.db
*.sqlite3

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
