# Root .env — used by docker-compose.
# Create ".env" by copying this file:
#   PowerShell:  Copy-Item .env.example .env
#   Git Bash:    cp .env.example .env

# ---------- PostgreSQL ----------
POSTGRES_USER=seatpulse
POSTGRES_PASSWORD=seatpulse_dev_password
POSTGRES_DB=seatpulse

# Port to expose the database on the host machine (for pgAdmin/DBeaver).
# Using 5433 because if PostgreSQL is already installed on the system,
# it occupies 5432, and pgAdmin might accidentally connect to it.
# The database inside the container always runs on 5432; this does not change.
POSTGRES_PORT=5433

# ---------- Redis ----------
# Port to expose Redis on the host machine.
# Change to 6380 if another Redis instance is already running on 6379.
# Redis inside the container always runs on 6379.
REDIS_PORT=6379
