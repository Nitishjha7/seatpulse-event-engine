# Root .env — ye docker-compose use karta hai.
# Copy karke ".env" banao:
#   PowerShell:  Copy-Item .env.example .env
#   Git Bash:    cp .env.example .env

# ---------- PostgreSQL ----------
POSTGRES_USER=seatpulse
POSTGRES_PASSWORD=seatpulse_dev_password
POSTGRES_DB=seatpulse

# Host machine pe kaunse port se DB dikhega (pgAdmin/DBeaver ke liye).
# 5433 isliye — agar system pe PostgreSQL already installed hai to wo 5432
# le chuka hota hai, aur pgAdmin galti se usi pe connect ho jata hai.
# Container ke andar DB hamesha 5432 pe hi rehta hai, wo isse nahi badalta.
POSTGRES_PORT=5433

# ---------- Redis ----------
# Host machine pe kaunse port se Redis dikhega.
# Koi aur Redis already 6379 pe chal raha ho to 6380 kar dena.
# Container ke andar Redis hamesha 6379 pe hi rehta hai.
REDIS_PORT=6379
