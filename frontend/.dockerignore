# Ye files container me copy NAHI hongi (COPY . . ke waqt).

# SABSE ZAROORI: local node_modules kabhi container me nahi jaana chahiye.
# Wo Windows ke liye bana hota hai, container Linux hai — binaries crash karti hain.
# Container apna node_modules khud "RUN npm install" se banata hai.
node_modules/

# Build output — container khud banata hai
dist/
dist-ssr/
build/
.vite/

# Secrets
.env
.env.*
*.local

# Git aur docs
.git
.gitignore
Dockerfile
.dockerignore
README.md
*.md

# Logs
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
