# These files will NOT be copied into the container (during COPY . .).

# MOST IMPORTANT: Local node_modules should never be copied into the container.
# It is built for Windows, while the container is Linux — binaries will crash.
# The container builds its own node_modules via "RUN npm install".
node_modules/

# Build output — generated by the container
dist/
dist-ssr/
build/
.vite/

# Secrets
.env
.env.*
*.local

# Git and docs
.git
.gitignore
Dockerfile
.dockerignore
README.md
*.md

# Logs
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
